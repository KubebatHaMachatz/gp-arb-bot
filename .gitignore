# credentials — never commit
.env
.env.*
# The ONLY exception, and it is narrow on purpose: the template carries variable NAMES and
# commentary, never values. Anything else matching .env.* stays ignored.
!.env.example
*credentials*
*.pem
*.key

# data / db
data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.csv
*.bak

# logs / reports
logs/
reports/
backups/

# node
# package-lock.json is deliberately NOT ignored. A-11 adds @noble/curves (pinned exact)
# on the order-signing path, which handles a hot wallet private key — the lockfile is what
# pins its transitive tree across installs. Ignoring it would leave that resolution
# floating on exactly the dependency where it matters most.
node_modules/
.stryker-tmp/

# os
.DS_Store
